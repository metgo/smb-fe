doctype html
html
  head
    title Forget Password - MetGo
  body
    header(style='background-color: #0279b1; padding: 15px; text-align: center;')
      img(src='https://pacecode.com.np/image/assets/logo_w.png', alt='MetGo Logo', style='max-width: 100%; height: 30px; width:30px')
      h2(style='margin-top: 10px; color: #fff;') Forget Password - MetGo

    main
      section
        p
          | Dear #{guestName},
        p
          | We received a request to reset your MetGo account password. Please use the following One-Time Password (OTP) within the next hour:
        p(style='font-size: 24px; font-weight: bold; color: #4CAF50; margin-top: 0; text-align: center;') #{otp}
        p
          | This OTP is valid for the next 1 hour. If you did not request a password reset, please ignore this email.

      section
        h2 Contact Information
        p
          | If you encounter any issues or have questions, feel free to contact us:
        ul
          li Email: support@metgo.app
          li Phone: +977-9863025214

      section
        p
          | Thank you for choosing MetGo. We appreciate the opportunity to assist you in securing your account.

    footer(style='background-color: #0279b1; color: #fff; text-align: center; padding: 10px;')
      p
        | © #{new Date().getFullYear()} MetGo. All rights reserved.
