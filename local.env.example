NODE_ENV=development
ENV_NAME=local
API_PORT=3000
BASE_URL=https://dev.api.metgo.app

# Database
DATABASE_ENCRYPTION_KEY=your_encryption_key
MONGODB_URI=MONGODB_URI

# JWT
JWT_TOKEN_EXPIRES=86400
ACCESS_TOKEN_EXPIRATION=86400
REFRESH_TOKEN_EXPIRATION=86400
OTP_EXPIRATION=86400
ACCESS_TOKEN=your_access_token
REFRESH_TOKEN=your_refresh_token

## email details
FROM_NAME=METGO
FROM_EMAIL=email
SERVICE_CLIENT=test
PRIVATE_KEY=test
ACCESS_URL=test

SUPER_ADMIN_EMAIL=email
SUPER_ADMIN_PASSWORD=password

## test email
EMAIL_HOST=your_email_host
PASSWORD=your_password
USER=your_username

## payment details
CARDCOM_URL=cardcom_url
CARDCOM_TERMINAL_NUMBER=1000
CARDCOM_API_NAME=api_name
PAYMENT_SUCCESS=success
PAYMENT_FAILURE=failure
PAYMENT_INDICATOR=indicator

## Cardcom invoices
CARDCOM_INVOICE_URL=cardcom_invoice_url
CARDCOM_INVOICE_API_PWD = cardcom_api_pwd

## IDENTIFIER FOR External API
IDENTIFIER_ID=TESTIDENTIFIERID123

## Email configuration-MAILCHIMP
MAILCHIMP_AUDIENCE=your_mailchimp_audience
MAILCHIMP_SERVER_PREFIX=your_mailchimp_server
MAILCHIMP_MARKETING_API_KEY=your_mailchimp_marketing_api
MAILCHIMP_TRANSACTIONAL_API_KEY=your_mailchimp_transactional_api
MAILCHIMP_FROM_EMAIL=your_mailchimp_email
MAILCHIMP_TAV8_SUPPORT_EMAIL=your_mailchimp_email


# Storage
GCS_BUCKET=metgo_test
MEDIA_STORAGE_FOLDER=storage/media
GCS_PROJECT_ID=metgo-dev-server
GCS_FILE_PATH=credentials/test
GOOGLE_SHEET_CONTACT_US=sheet123

## Google Analytics
GA_BALA_PROPERTY_ID = bala_property_id
GA_TAV8_PROPERTY_ID = tav8_property_id

## Oauth
GOOGLE_CLIENT_ID = **your_client_id**
GOOGLE_CLIENT_SECRET = **your_client_secret**
GOOGLE_REDIRECT_URI = **your_redirect_url**
FE_BASE_URL = **your_fe_base_url**

SMS_CONFIRM_PURCHASE_TOKEN=**your_Sms_token**
